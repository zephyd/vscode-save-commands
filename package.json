{
  "name": "save-commands-enhanced",
  "displayName": "Save Commands Enhanced",
  "description": "Enhanced extension to save, organize and execute terminal commands efficiently.",
  "icon": "resources/logo.png",
  "version": "1.3.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "keywords": [
    "commands",
    "productivity",
    "workflows",
    "terminal"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Save Commands Enhanced",
      "properties": {
        "save-commands.placeholderType": {
          "type": "string",
          "default": "doubleCurlyBraces",
          "enum": [
            "singleCurlyBraces",
            "doubleCurlyBraces",
            "singleAngleBraces",
            "doubleAngleBraces"
          ],
          "description": "Set placeholder string type. This will be used to detect placeholders in your commands. This won't affect your existing commands",
          "enumDescriptions": [
            "{name}",
            "{{name}}",
            "<name>",
            "<<name>>"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "save-commands.refreshView",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "save-commands.deleteCommand",
        "title": "Delete Command",
        "category": "Save Commands"
      },
      {
        "command": "save-commands.reset",
        "title": "Delete All Saved Commands",
        "category": "Save Commands"
      },
      {
        "command": "save-commands.addCommand",
        "title": "Add Command",
        "icon": {
          "light": "resources/light/add.svg",
          "dark": "resources/dark/add.svg"
        },
        "category": "Save Commands"
      },
      {
        "command": "save-commands.editCommand",
        "title": "Edit Command",
        "icon": {
          "light": "resources/light/edit.svg",
          "dark": "resources/dark/edit.svg"
        },
        "category": "Save Commands"
      },
      {
        "command": "save-commands.editFolder",
        "title": "Edit Folder",
        "icon": {
          "light": "resources/light/edit.svg",
          "dark": "resources/dark/edit.svg"
        },
        "category": "Save Commands"
      },
      {
        "command": "save-commands.deleteCommands",
        "title": "Delete Commands",
        "icon": {
          "light": "resources/light/trash.svg",
          "dark": "resources/dark/trash.svg"
        },
        "category": "Save Commands"
      },
      {
        "command": "save-commands.runCommand",
        "title": "Try Running Command",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/run.svg",
          "dark": "resources/dark/run.svg"
        }
      },
      {
        "command": "save-commands.runCommandInActiveTerminal",
        "title": "Try Running Command In Active Terminal",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/run_active.svg",
          "dark": "resources/dark/run_active.svg"
        }
      },
      {
        "command": "save-commands.copyCommand",
        "title": "Copy Command to Clipboard",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/copy.svg",
          "dark": "resources/dark/copy.svg"
        }
      },
      {
        "command": "save-commands.addFolder",
        "title": "Add Folder",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/new_folder.svg",
          "dark": "resources/dark/new_folder.svg"
        }
      },
      {
        "command": "save-commands.deleteFolder",
        "title": "Delete Folder",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/trash.svg",
          "dark": "resources/dark/trash.svg"
        }
      },
      {
        "command": "save-commands.runFolder",
        "title": "Try Running Folder Commands",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/run.svg",
          "dark": "resources/dark/run.svg"
        }
      },
      {
        "command": "save-commands.runFolderInActiveTerminal",
        "title": "Try Running Folder Commands In Active Terminal",
        "category": "Save Commands",
        "icon": {
          "light": "resources/light/run_active.svg",
          "dark": "resources/dark/run_active.svg"
        }
      },
      {
        "command": "save-commands.openConfigFile",
        "title": "Open Workspace Config (JSON)",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/config.svg",
          "dark": "resources/dark/config.svg"
        }
      },
      {
        "command": "save-commands.openGlobalConfigFile",
        "title": "Open Global Config (JSON)",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/config.svg",
          "dark": "resources/dark/config.svg"
        }
      },
      {
        "command": "save-commands.sshConnect",
        "title": "SSH Connect",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/run.svg",
          "dark": "resources/dark/run.svg"
        }
      },
      {
        "command": "save-commands.sshConnectInActiveTerminal",
        "title": "SSH Connect In Active Terminal",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/run_active.svg",
          "dark": "resources/dark/run_active.svg"
        }
      },
      {
        "command": "save-commands.addSshConnection",
        "title": "Add SSH Connection",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/add.svg",
          "dark": "resources/dark/add.svg"
        }
      },
      {
        "command": "save-commands.deleteSshConnection",
        "title": "Delete SSH Connection",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/trash.svg",
          "dark": "resources/dark/trash.svg"
        }
      },
      {
        "command": "save-commands.openSshConfigFile",
        "title": "Open Workspace SSH Config (JSON)",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/config.svg",
          "dark": "resources/dark/config.svg"
        }
      },
      {
        "command": "save-commands.openGlobalSshConfigFile",
        "title": "Open Global SSH Config (JSON)",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/config.svg",
          "dark": "resources/dark/config.svg"
        }
      },
      {
        "command": "save-commands.editSshConnection",
        "title": "Edit SSH Connection",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/edit.svg",
          "dark": "resources/dark/edit.svg"
        }
      },
      {
        "command": "save-commands.browseRemoteFiles",
        "title": "Browse Remote Files",
        "category": "Save Commands Enhanced",
        "icon": {
          "light": "resources/light/folder.svg",
          "dark": "resources/dark/folder.svg"
        }
      },
      {
        "command": "save-commands.openTerminalAtRemoteDir",
        "title": "Open Terminal Here",
        "category": "Save Commands Enhanced",
        "icon": "$(terminal)"
      },
      {
        "command": "save-commands.syncExplorerToTerminal",
        "title": "Sync Explorer to Terminal",
        "category": "Save Commands Enhanced",
        "icon": "$(sync)"
      },
      {
        "command": "save-commands.refreshRemoteExplorer",
        "title": "Refresh Explorer",
        "category": "Save Commands Enhanced",
        "icon": "$(refresh)"
      },
      {
        "command": "save-commands.goUpRemoteExplorer",
        "title": "Go Up",
        "category": "Save Commands Enhanced",
        "icon": "$(arrow-up)"
      },
      {
        "command": "save-commands.remoteNewFile",
        "title": "New File",
        "category": "Save Commands Enhanced",
        "icon": "$(new-file)"
      },
      {
        "command": "save-commands.remoteNewFolder",
        "title": "New Folder",
        "category": "Save Commands Enhanced",
        "icon": "$(new-folder)"
      },
      {
        "command": "save-commands.remoteRename",
        "title": "Rename",
        "category": "Save Commands Enhanced",
        "icon": "$(edit)"
      },
      {
        "command": "save-commands.remoteDelete",
        "title": "Delete",
        "category": "Save Commands Enhanced",
        "icon": "$(trash)"
      },
      {
        "command": "save-commands.remoteCopyPath",
        "title": "Copy Path",
        "category": "Save Commands Enhanced",
        "icon": "$(copy)"
      },
      {
        "command": "save-commands.remoteCopyRelativePath",
        "title": "Copy Relative Path",
        "category": "Save Commands Enhanced",
        "icon": "$(copy)"
      },
      {
        "command": "save-commands.remoteCopy",
        "title": "Copy",
        "category": "Save Commands Enhanced",
        "icon": "$(files)"
      },
      {
        "command": "save-commands.remoteCut",
        "title": "Cut",
        "category": "Save Commands Enhanced",
        "icon": "$(scissors)"
      },
      {
        "command": "save-commands.remotePaste",
        "title": "Paste",
        "category": "Save Commands Enhanced",
        "icon": "$(files)"
      },
      {
        "command": "save-commands.remoteDownload",
        "title": "Download",
        "category": "Save Commands Enhanced",
        "icon": "$(cloud-download)"
      },
      {
        "command": "save-commands.remoteUploadFiles",
        "title": "Upload Files...",
        "category": "Save Commands Enhanced",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "save-commands.remoteUploadFolder",
        "title": "Upload Folder...",
        "category": "Save Commands Enhanced",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "save-commands.attachDocker",
        "title": "Attach Docker Container...",
        "category": "Save Commands Enhanced",
        "icon": "$(symbol-class)"
      },
      {
        "command": "save-commands.attachK8s",
        "title": "Attach Kubernetes Pod...",
        "category": "Save Commands Enhanced",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "save-commands.disconnectRemote",
        "title": "Disconnect Remote Connection",
        "category": "Save Commands Enhanced",
        "icon": "$(debug-disconnect)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "save-commands-container",
          "title": "Save Commands Enhanced",
          "icon": "resources/dark/enhanced_run.svg"
        }
      ]
    },
    "views": {
      "save-commands-container": [
        {
          "id": "save-commands-view",
          "name": "Commands",
          "icon": "resources/enhanced_run.svg"
        },
        {
          "id": "save-commands-ssh-view",
          "name": "SSH Connections",
          "icon": "resources/enhanced_run.svg"
        },
        {
          "id": "save-commands-remote-view",
          "name": "Remote File Explorer",
          "icon": "resources/folder.svg"
        },
        {
          "id": "save-commands-form-view",
          "name": "Add / Edit Command",
          "type": "webview",
          "visibility": "collapsed",
          "icon": "resources/config.svg",
          "when": "save-commands.form-active"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "save-commands.refreshView",
          "when": "false"
        },
        {
          "command": "save-commands.deleteCommand",
          "when": "false"
        },
        {
          "command": "save-commands.deleteCommands",
          "when": "false"
        },
        {
          "command": "save-commands.editCommand",
          "when": "false"
        },
        {
          "command": "save-commands.runCommand",
          "when": "false"
        },
        {
          "command": "save-commands.runCommandInActiveTerminal",
          "when": "false"
        },
        {
          "command": "save-commands.copyCommand",
          "when": "false"
        },
        {
          "command": "save-commands.reset"
        },
        {
          "command": "save-commands.addFolder",
          "when": "false"
        },
        {
          "command": "save-commands.deleteFolder",
          "when": "false"
        },
        {
          "command": "save-commands.addCommand",
          "when": "false"
        },
        {
          "command": "save-commands.editFolder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "save-commands.reset",
          "when": "view == save-commands-view"
        },
        {
          "command": "save-commands.refreshView",
          "when": "view == save-commands-view || view == save-commands-ssh-view",
          "group": "navigation@1"
        },
        {
          "command": "save-commands.goUpRemoteExplorer",
          "group": "navigation@1",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.refreshRemoteExplorer",
          "group": "navigation@2",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.openTerminalAtRemoteDir",
          "group": "navigation@3",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.syncExplorerToTerminal",
          "group": "navigation@4",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteNewFile",
          "group": "navigation@5",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteNewFolder",
          "group": "navigation@6",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.disconnectRemote",
          "group": "navigation@7",
          "when": "view == save-commands-remote-view && save-commands.remote-active"
        }
      ],
      "view/item/context": [
        {
          "command": "save-commands.editCommand",
          "when": "view == save-commands-view && viewItem == command"
        },
        {
          "command": "save-commands.deleteCommand",
          "when": "view == save-commands-view && viewItem == command"
        },
        {
          "command": "save-commands.deleteFolder",
          "when": "view == save-commands-view && viewItem == folder"
        },
        {
          "command": "save-commands.editFolder",
          "when": "view == save-commands-view && viewItem == folder"
        },
        {
          "command": "save-commands.runFolder",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == folder"
        },
        {
          "command": "save-commands.runFolderInActiveTerminal",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == folder"
        },
        {
          "command": "save-commands.copyCommand",
          "when": "view == save-commands-view && viewItem == command",
          "group": "inline"
        },
        {
          "command": "save-commands.runCommand",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == command"
        },
        {
          "command": "save-commands.runCommandInActiveTerminal",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == command"
        },
        {
          "command": "save-commands.addCommand",
          "group": "inline",
          "when": "view == save-commands-view && viewItem =~ /root-global$|root-workspace$/ || viewItem == folder"
        },
        {
          "command": "save-commands.deleteCommands",
          "when": "view == save-commands-view && viewItem =~ /root-global$|root-workspace$/"
        },
        {
          "command": "save-commands.addFolder",
          "group": "inline",
          "when": "view == save-commands-view && viewItem =~ /root-global$|root-workspace$/ || viewItem == folder"
        },
        {
          "command": "save-commands.openGlobalConfigFile",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == root-global"
        },
        {
          "command": "save-commands.openConfigFile",
          "group": "inline",
          "when": "view == save-commands-view && viewItem == root-workspace"
        },
        {
          "command": "save-commands.sshConnect",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.sshConnectInActiveTerminal",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.deleteSshConnection",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.editSshConnection",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.addSshConnection",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem =~ /root-.*-ssh/"
        },
        {
          "command": "save-commands.openGlobalSshConfigFile",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == root-global-ssh"
        },
        {
          "command": "save-commands.openSshConfigFile",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == root-workspace-ssh"
        },
        {
          "command": "save-commands.browseRemoteFiles",
          "group": "inline",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.attachDocker",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.attachK8s",
          "when": "view == save-commands-ssh-view && viewItem == sshConnection"
        },
        {
          "command": "save-commands.openTerminalAtRemoteDir",
          "group": "inline",
          "when": "view == save-commands-remote-view && viewItem == directory"
        },
        {
          "command": "save-commands.remoteNewFile",
          "group": "remoteFileAction@1",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteNewFolder",
          "group": "remoteFileAction@2",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteRename",
          "group": "remoteFileAction@3",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteDelete",
          "group": "remoteFileAction@4",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteCopy",
          "group": "remoteClipboard@1",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteCut",
          "group": "remoteClipboard@2",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remotePaste",
          "group": "remoteClipboard@3",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteCopyPath",
          "group": "remoteClipboard@4",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteCopyRelativePath",
          "group": "remoteClipboard@5",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteDownload",
          "group": "remoteClipboard@6",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteUploadFiles",
          "group": "remoteClipboard@7",
          "when": "view == save-commands-remote-view"
        },
        {
          "command": "save-commands.remoteUploadFolder",
          "group": "remoteClipboard@8",
          "when": "view == save-commands-remote-view"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --config ./build/node-extension.webpack.config.js",
    "watch": "webpack --watch --config ./build/node-extension.webpack.config.js",
    "package": "webpack --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "yarn run test-compile && yarn run lint",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write --unsafe ./src",
    "format": "biome format --write ./src",
    "test": "node ./out/test/runTest.js",
    "unit-test": "mocha"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.6.4",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vscode/test-electron": "^2.1.5",
    "glob": "^11.0.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vscode-test": "^1.6.1",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codectyl/vscode-save-commands"
  },
  "license": "MIT",
  "publisher": "zephyd",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.13",
    "ssh2": "^1.17.0"
  }
}
